# STALE 2026-08-20 soak draft — DO NOT INSTALL ON NIGHT 4.
# Live llama is CT 210 llama-vulkan @ 192.168.1.240:8080.
# Canonical unit: 690-routing/llama-server.service
#   (Nemotron Q5_K_M, 131k, --reasoning off, MTP, alias nemotron-3.5-lightning-30b-a3b)
# Starting THIS unit on the host fights CT 210 for the R9700 (Q4_K_M, 64k, port 8090).
#
# Historical notes below kept for the soak bench record only.
[Unit]
Description=llama-server (Nemotron 3.5 Lightning 30B-A3B Q4_K_M, R9700 Vulkan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# single AMD ICD on this host (RADV) — no VK_LOADER_DRIVERS_SELECT pin needed;
# only set VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json if the
# Intel iGPU ICD ever interferes (llvmpipe/intel entries exist alongside).
WorkingDirectory=/mnt/stage/llama/llama-b10488
ExecStart=/mnt/stage/llama/llama-b10488/llama-server \
  --model /mnt/stage/llama/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_K_M.gguf \
  --host 0.0.0.0 \
  --port 8090 \
  --alias local-llm \
  --gpu-layers 99 \
  --ctx-size 65536 \
  --parallel 1 \
  --jinja \
  --batch-size 2048 \
  --ubatch-size 512 \
  --cont-batching \
  --flash-attn on \
  --reasoning off
# --reasoning off is CRITICAL (burns 1500+ hidden tokens/req without it).
# No MTP/spec decode — tested net-slower on Vulkan. No KV quant flags = f16.
# Port 8090: internal; guardian/proxy fronting moves to AIWA later or clients
# hit this directly — decide at Gate 4. Old Windows prod used guardian :8080.
Restart=on-failure
RestartSec=5
# memory ceiling: 25.5G model + ctx; host has 64G
MemoryMax=40G

[Install]
WantedBy=multi-user.target
