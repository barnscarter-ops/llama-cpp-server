# Copy this to .env and fill in your tokens
# (Never commit .env to git)

SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN-HERE
SLACK_APP_TOKEN=xapp-YOUR-APP-TOKEN-HERE

# Optional overrides (defaults shown)
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_MODEL=qwen3.6-35b-a3b
MAX_HISTORY_TURNS=20
SYSTEM_PROMPT=You are a helpful local AI assistant. Be concise and direct. You are being accessed via Slack from a mobile device, so keep responses readable on a phone.

# Hermes-decided local Qwen queue. The defaults use the active Hermes profile.
HERMES_DECIDER_EXE=hermes
HERMES_DECIDER_PROVIDER=
HERMES_DECIDER_MODEL=
HERMES_DECIDER_TIMEOUT_S=60
GUARDIAN_QUEUE_DB=C:\Workspace\Infrastructure\llama-cpp-server\logs\guardian-queue.sqlite3
GUARDIAN_QUEUE_ALLOW_REMOTE=false
GUARDIAN_QUEUE_TOKEN=
